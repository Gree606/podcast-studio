# Copy to .env for NON-SECRET settings. Never commit .env.
# API KEYS DO NOT GO HERE. They live outside the repo in ~/.config/podcast-studio/secrets.env
# (create it with: python scripts/init_secrets.py), or in the file named by PODCAST_SECRETS_FILE.
# While any required key is still DUMMY_..., the app runs in demo mode (placeholder voices).

# ---- LLM: Google Gemini (generateContent) --------------------------------
LLM_PROVIDER=gemini
LLM_BASE_URL=https://generativelanguage.googleapis.com
LLM_MODEL=gemini-3.6-flash
LLM_FALLBACK_MODELS=gemini-3.5-flash,gemini-flash-latest,gemini-3.5-flash-lite,gemini-flash-lite-latest
# LLM_API_KEY goes in the secrets file (see top of this file)
LLM_MAX_CONCURRENCY=4

# ---- LLM via OpenRouter (same Gemini models, paid per token: no free-tier daily cap) ----
# To switch: comment out the four Gemini lines above and uncomment these. Put the key in the
# secrets file as OPENROUTER_API_KEY=... (the Gemini key stays there, so switching back is easy).
# LLM_PROVIDER=openrouter
# LLM_BASE_URL=https://openrouter.ai/api
# LLM_MODEL=google/gemini-3.6-flash
# LLM_FALLBACK_MODELS=google/gemini-3.5-flash,google/gemini-3.7-flash,google/gemini-3.5-flash-lite

# ---- TTS: Sarvam AI (bulbul) ---------------------------------------------
TTS_API_STYLE=sarvam
TTS_BASE_URL=https://api.sarvam.ai
TTS_MODEL=bulbul:v4-flash
# TTS_API_KEY goes in the secrets file
TTS_LANGUAGE=en-IN
TTS_VOICE_HOST=simran_en_conversation
TTS_VOICE_EXPERT=dev_en_conversational
TTS_PACE=1.05

# ---- Alternative TTS: Bodhan indic-speak (uses the Bodhan key as TTS_API_KEY) ----
# TTS_API_STYLE=bodhan
# TTS_BASE_URL=https://api.bodhan.ai
# TTS_MODEL=indic-speak
# TTS_VOICE_HOST=Deepika          # female voices: Deepika, Anitha, Sravani, Saba, Srijana
# TTS_VOICE_EXPERT=Amit           # male voices: Amit, Kiran
# TTS_LANGUAGE=en-IN              # sent as instructions '{"lang": "en"}'
# TTS_REQUESTS_PER_MINUTE=8       # Bodhan rate-limits bursts (measured 2026-10-23)

# ---- ASR (audio self-check): Bodhan --------------------------------------
ASR_BASE_URL=https://api.bodhan.ai
ASR_MODEL=indic-transcribe
# ASR_API_KEY goes in the secrets file
ASR_AUTH_PREFIX=
# ASR_LANGUAGE=en        # default: the TTS language (en for en-IN); "auto" lets Bodhan detect it

# ---- OCR of scanned PDFs: uses the LLM's vision input ---------------------
OCR_MODE=bodhan

# ---- Server / pipeline -----------------------------------------------------
DATA_DIR=./data
MAX_CONCURRENT_EPISODES=3
BUDGET_PER_SEGMENT=2.0
ACCEPT_SCORE=4.2
WER_THRESHOLD=0.25

# Optional: a different model to judge eval runs (eval/run_eval.py)
# EVAL_JUDGE_BASE_URL=
# EVAL_JUDGE_API_KEY=
# EVAL_JUDGE_MODEL=

# Entry gate: the secret code Error606 asks for (anything that spends API calls needs it).
# Empty = no gate. Case and surrounding spaces are ignored.
ACCESS_CODE=

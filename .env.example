# Copy to .env for NON-SECRET settings. Never commit .env.
# API KEYS DO NOT GO HERE. They live outside the repo in ~/.config/podcast-studio/secrets.env
# (create it with: python scripts/init_secrets.py), or in the file named by PODCAST_SECRETS_FILE.
# While any required key is still DUMMY_..., the app runs in demo mode (placeholder voices).

# ---- LLM: Gemini models through OpenRouter (default; paid per token, no daily cap) ----
# Needs OPENROUTER_API_KEY in the secrets file. The same key also powers the deep agent's embeddings.
LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api
LLM_MODEL=google/gemini-3.6-flash
LLM_FALLBACK_MODELS=google/gemini-3.5-flash,google/gemini-3.7-flash,google/gemini-3.5-flash-lite
LLM_MAX_CONCURRENCY=4

# ---- Alternative: Google Gemini directly (AI Studio key as LLM_API_KEY; free tier has daily caps) ----
# Comment out the four OpenRouter lines above and uncomment these. Either way, the other one can
# still be picked per episode in the app's Settings if its key is set.
# LLM_PROVIDER=gemini
# LLM_BASE_URL=https://generativelanguage.googleapis.com
# LLM_MODEL=gemini-3.6-flash
# LLM_FALLBACK_MODELS=gemini-3.5-flash,gemini-flash-latest,gemini-3.5-flash-lite,gemini-flash-lite-latest

# ---- TTS: Sarvam AI (bulbul) ---------------------------------------------
TTS_API_STYLE=sarvam
TTS_BASE_URL=https://api.sarvam.ai
TTS_MODEL=bulbul:v4-flash
# TTS_API_KEY goes in the secrets file
TTS_LANGUAGE=en-IN
TTS_VOICE_HOST=dev_en_conversational      # Error606, the alien (asks)
TTS_VOICE_EXPERT=simran_en_conversation   # Gree, the astronaut (explains)
TTS_PACE=1.05

# ---- Alternative TTS: Bodhan indic-speak as the default (its key goes in the secrets file as TTS_API_KEY) ----
# Not needed to use Bodhan voices: with BODHAN_TTS_API_KEY set, they can be picked in Settings, and are used
# automatically when there is no Sarvam key.
# TTS_API_STYLE=bodhan
# TTS_BASE_URL=https://api.bodhan.ai
# TTS_MODEL=indic-speak
# TTS_VOICE_HOST=Amit             # male voices: Amit, Kiran
# TTS_VOICE_EXPERT=Deepika        # female voices: Deepika, Anitha, Sravani, Saba, Srijana
# TTS_LANGUAGE=en-IN              # sent as instructions '{"lang": "en"}'
# TTS_REQUESTS_PER_MINUTE=8       # Bodhan rate-limits bursts (measured 2026-10-23)

# ---- ASR (audio self-check): Bodhan --------------------------------------
ASR_BASE_URL=https://api.bodhan.ai
ASR_MODEL=indic-transcribe
# ASR_API_KEY goes in the secrets file
ASR_AUTH_PREFIX=
# ASR_LANGUAGE=en        # default: the TTS language (en for en-IN); "auto" lets Bodhan detect it

# ---- OCR of scanned PDFs: uses the LLM's vision input ---------------------
OCR_MODE=bodhan

# ---- Server / pipeline -----------------------------------------------------
DATA_DIR=./data
MAX_CONCURRENT_EPISODES=3
BUDGET_PER_SEGMENT=2.0
ACCEPT_SCORE=4.2
WER_THRESHOLD=0.25

# Optional: a different model to judge eval runs (eval/run_eval.py)
# EVAL_JUDGE_BASE_URL=
# EVAL_JUDGE_API_KEY=
# EVAL_JUDGE_MODEL=

# Entry gate: the secret code Error606 asks for (anything that spends API calls needs it).
# Empty = no gate. Case and surrounding spaces are ignored.
ACCESS_CODE=

# ---- Embeddings for the deep agent's hybrid retrieval (BM25 + meaning search) ----
# Uses OPENROUTER_API_KEY from the secrets file unless EMBED_API_KEY is set. Empty model = keyword search only.
EMBED_MODEL=google/gemini-embedding-001
# EMBED_BASE_URL=https://openrouter.ai/api
# Deep agent: most LLM calls per job (0 = no cap); AGENT_STYLE=per_part = the older best-of-N-per-part agent (25-48 calls)
DEEP_MAX_LLM_CALLS=10

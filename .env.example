# Copy to .env and fill in. Never commit .env.
# With no LLM_BASE_URL set, the app runs in demo (mock) mode.
MOCK_MODE=0

# LLM: any OpenAI-compatible /v1/chat/completions server (vLLM serving Gemma, etc.)
LLM_BASE_URL=http://localhost:8000
LLM_API_KEY=
LLM_MODEL=gemma-4-31b
LLM_MAX_CONCURRENCY=6
LLM_VISION=1            # model accepts images -> used for OCR of scanned pages

# TTS: TTS_API_STYLE=openai -> POST {base}/v1/audio/speech ; =json -> POST {base}/synthesize
TTS_API_STYLE=openai
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=
TTS_VOICE_HOST=
TTS_VOICE_EXPERT=
TTS_LANGUAGE=en
TTS_MAX_CONCURRENCY=4

# ASR (self-check): OpenAI-style POST {base}/v1/audio/transcriptions. Leave empty to skip self-check.
ASR_BASE_URL=
ASR_API_KEY=
ASR_MODEL=
ASR_LANGUAGE=en

# OCR for scanned PDFs: llm (vision LLM) | http (dedicated endpoint) | off
OCR_MODE=llm

# Pipeline
DATA_DIR=./data
MAX_CONCURRENT_EPISODES=3
BUDGET_PER_SEGMENT=2.0
ACCEPT_SCORE=4.2
WER_THRESHOLD=0.25

# Optional: a different model to judge eval runs (eval/run_eval.py)
EVAL_JUDGE_BASE_URL=
EVAL_JUDGE_API_KEY=
EVAL_JUDGE_MODEL=
